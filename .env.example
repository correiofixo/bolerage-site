# Porta em que o servidor Node vai escutar.
# No DigitalOcean App Platform isso é injetado automaticamente; em um Droplet, defina você mesmo.
PORT=3000

# Caminho do arquivo do banco SQLite. Em um Droplet, aponte para um volume persistente
# (fora da pasta do repositório) para o banco sobreviver a deploys/reinícios.
DB_PATH=./data/bolerage.db
